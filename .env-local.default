# Environment for local development. The application always runs on the host, so
# these values also apply to `make dockerrun`, which uses --net=host.
# Copied to .env-local (gitignored) by `make setup`; edit that copy to override.

PYGEOAPI_CONFIG=./pygeoapi-config.yml
PYGEOAPI_OPENAPI=./pygeoapi-openapi.yml

# OpenSearch is provided by the service-control stack.
OPENSEARCH_URL=http://localhost:9200

# Traces go to the service-control collector, in plaintext.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
