{
  "settings": {
    "analysis": {
      "normalizer": {
        "sortable": {
          "type": "custom",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": {"type": "keyword"},
      "type": {"type": "keyword"},
      "geometry": {"type": "geo_shape"},
      "properties": {
        "properties": {
          "type": {"type": "keyword"},
          "title": {
            "properties": {
              "de": {"type": "text", "fields": {"raw": {"type": "keyword", "normalizer": "sortable", "ignore_above": 1024}}},
              "en": {"type": "text", "fields": {"raw": {"type": "keyword", "normalizer": "sortable", "ignore_above": 1024}}},
              "fr": {"type": "text", "fields": {"raw": {"type": "keyword", "normalizer": "sortable", "ignore_above": 1024}}},
              "it": {"type": "text", "fields": {"raw": {"type": "keyword", "normalizer": "sortable", "ignore_above": 1024}}}
            }
          },
          "description": {
            "properties": {
              "de": {"type": "text"},
              "en": {"type": "text"},
              "fr": {"type": "text"},
              "it": {"type": "text"}
            }
          },
          "keywords": {"type": "keyword"},
          "preferredDistributionId": {"type": "keyword"}
        }
      }
    }
  }
}
