            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.geochemischer-bodenatlas_schweiz_uran:wmts",
        "title": "Atlas géochimique des sols de la Suisse: Uranium",
        "type": "Dataset"
      }
