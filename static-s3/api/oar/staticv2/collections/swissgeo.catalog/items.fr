            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.bundesinventare-amphibien:wmts",
        "title": "Inventaire fédéral des sites de reproduction de batraciens d'importance nationale - Objets fixes",
        "type": "Dataset"
      }
    },
