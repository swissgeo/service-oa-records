            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bfe.ladebedarfswelt-ladepunkte_bequem:wmts",
        "title": "Nombre de points de recharge accessibles à tous dans l'univers de recharge «confortable» pour l'année 2035",
        "type": "Dataset"
      }
