            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.gewaesserschutz-chemischer_zustand_nitrat:wms",
        "title": "L’appréciation de l’état chimique des eaux au regard des concentrations de nitrates",
        "type": "Dataset"
      }
