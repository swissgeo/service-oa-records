            "name": "Italiano",
            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bfe.biomasse-nicht-verholzt:wmts",
        "title": "Potentiel durable des ressources de biomasse non ligneuse pour la production de bioénergie en Suisse à l'échelle municipale",
        "type": "Dataset"
      }
    },
