            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bfe.meteorologische-vereisung:wmts",
        "title": "Atlas des vents de la Suisse: Fréquence du givrage météorologique à 100 m du sol",
        "type": "Dataset"
      }
