            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.swisstopo.swisseo_vhi_v100:wms",
        "title": "swissEO VHI: État de santé de la forêt",
        "type": "Dataset"
      }
