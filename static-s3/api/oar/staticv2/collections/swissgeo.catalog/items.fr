            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.geochemischer-bodenatlas_schweiz_cobalt:wmts",
        "title": "Atlas géochimique des sols de la Suisse: Cobalt",
        "type": "Dataset"
      }
