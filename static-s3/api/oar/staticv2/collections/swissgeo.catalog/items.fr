            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": null,
        "title": "SORA - Carte pour le risque intrinsèque au sol",
        "type": "Dataset"
      }
    },
