            "name": "Italiano",
            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.erosion-gruenland_bodenabtrag_apr:wmts",
        "title": "Cartes mensuelles des risques d'érosion des prairies permanentes suisses, perte moyenne de sol en tonnes (ha*mois), avril",
        "type": "Dataset"
      }
