            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.klima-co2_ausstoss_gebaeude:wmts",
        "title": "Estimation des émissions de CO₂ directes sur la base des besoins en chaleur selon la norme SIA 380/1 (2016)",
