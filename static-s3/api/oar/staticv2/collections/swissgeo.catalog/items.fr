            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.erosion-gruenland_bodenabtrag_mai:wmts",
        "title": "Cartes mensuelles des risques d'érosion des prairies permanentes suisses, perte moyenne de sol en tonnes (ha*mois), mai",
        "type": "Dataset"
      }
