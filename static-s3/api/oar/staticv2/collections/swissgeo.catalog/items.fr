          }
        ],
        "preferredDistributionId": "ch.bfe.ladebedarfswelt-ladepunkte_geplant:wmts",
        "title": "Nombre de points de recharge accessibles à tous dans l'univers de recharge « Planifié » pour 2035",
        "type": "Dataset"
      }
    },
