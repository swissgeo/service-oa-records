          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.geochemischer-bodenatlas_schweiz_arsen:wmts",
        "title": "Atlas géochimique des sols de la Suisse: Arsenic",
