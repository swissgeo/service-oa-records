            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bfe.windenergie-geschwindigkeit_h125:wms",
        "title": "Atlas des vents de la Suisse: moyenne annuelle modélisée de la vitesse et de la direction du vent à 125 m du sol",
        "type": "Dataset"
      }
    },
