            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bfe.ladebedarfswelt-strombedarf:wmts",
        "title": "Besoin en électricité dans l'univers de recharge « Confortable » pour les véhicules branchés pour l'année 2035",
        "type": "Dataset"
      }
    },
