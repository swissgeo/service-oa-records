            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.bundesinventare-amphibien_anhang4:wmts",
        "title": "Inventaire des sites de reproduction de batraciens d'importance nationale, annexe 3",
        "type": "Dataset"
      }
