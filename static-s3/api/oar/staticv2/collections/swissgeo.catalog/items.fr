            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.swisstopo.hiks-siegfried:wmts",
        "title": "Atlas topographique de la Suisse (Carte Siegfried)",
        "type": "Dataset"
      }
    },
