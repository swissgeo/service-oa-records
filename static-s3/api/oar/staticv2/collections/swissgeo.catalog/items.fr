            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bfe.fernwaerme-nachfrage_wohn_dienstleistungsgebaeude:wmts",
        "title": "Réseaux thermiques: demande concernant les bâtiments d'habitation ou administratifs",
        "type": "Dataset"
      }
    },
