            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.wald-foehnhaeufigkeit_jahr:wmts",
        "title": "Fréquence annuelle de foehn, période variable (maximum 1969-2013)",
        "type": "Dataset"
      }
