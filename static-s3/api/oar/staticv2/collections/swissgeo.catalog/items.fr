            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.aquaprotect_100:wmts",
        "title": "Zones inondables Aquaprotect: période de retour de 100 ans",
        "type": "Dataset"
      }
    },
