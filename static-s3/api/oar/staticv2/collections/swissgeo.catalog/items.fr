          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bazl.laermbelastungskataster-zivilflugplaetze_klein-grossflugzeuge:wms",
        "title": "Cadastres de bruit pour les aérodromes civils - Exposition au bruit due aux petits aéronefs et aux grands avions Lrt (06-22 heures)",
        "type": "Dataset"
      }
