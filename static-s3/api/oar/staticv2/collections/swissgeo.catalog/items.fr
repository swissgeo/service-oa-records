            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.niederschlagserosivitaet-nov:wmts",
        "title": "Cartes mensuelles de l'action érosive des précipitations (facteur R) en Suisse en MJ mm ha⁻¹ h⁻¹ mois⁻¹, novembre",
        "type": "Dataset"
      }
