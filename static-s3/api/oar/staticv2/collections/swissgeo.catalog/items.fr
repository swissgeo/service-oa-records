          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.erosion-gruenland_bodenabtrag_okt:wmts",
        "title": "Cartes mensuelles des risques d'érosion des prairies permanentes suisses, perte moyenne de sol en tonnes (ha*mois), octobre",
        "type": "Dataset"
      }
