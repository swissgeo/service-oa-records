            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.bundesinventare-moorlandschaften:wmts",
        "title": "Inventaire fédéral des sites marécageux d'une beauté particulière et d'importance nationale",
        "type": "Dataset"
      }
