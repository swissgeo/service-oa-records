            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.swisstopo.geologie-geomol_hoehe_top_lias:wms",
        "title": "Modèle géologique 3D du bassin molassique suisse – altitude du toit du Lias",
        "type": "Dataset"
      }
