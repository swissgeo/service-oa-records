            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.geochemischer-bodenatlas_schweiz_cadmium:wmts",
        "title": "Atlas géochimique des sols de la Suisse: Cadmium",
        "type": "Dataset"
      }
