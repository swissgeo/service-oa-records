            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.amphibienwanderung-verkehrskonflikte:wmts",
        "title": "Migration d‘amphibiens avec conflits avec la circulation",
        "type": "Dataset"
      }
