            "code": "it",
            "name": "Italiano",
            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bazl.intrinsisches-bodenrisiko_sora_200:wmts",
        "title": "SORA - Carte pour le risque intrinsèque au sol 200m",
        "type": "Dataset"
      }
    },
