            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.aquaprotect_250:wmts",
        "title": "Zones inondables Aquaprotect: période de retour de 250 ans",
        "type": "Dataset"
      }
    },
