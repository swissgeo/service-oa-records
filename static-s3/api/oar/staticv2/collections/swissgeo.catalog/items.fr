          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.gewaesserschutz-biologischer_zustand_makrozoobenthos:wms",
        "title": "L’appréciation de l’état biologique des eaux au regard des analyses du macrozoobenthos",
        "type": "Dataset"
      }
