            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.agroscope.korridore-feuchtgebietsarten_bereiche:wmts",
        "title": "Corridors potentiels entre objets protégés pour les espèces des zones humides ouvertes (OFG-Arten)",
        "type": "Dataset"
      }
