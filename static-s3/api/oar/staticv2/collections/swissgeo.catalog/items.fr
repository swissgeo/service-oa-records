          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.fauna-wildtierpassagen:wmts",
        "title": "Passage à faune de la suisse",
        "type": "Dataset"
      }
    },
