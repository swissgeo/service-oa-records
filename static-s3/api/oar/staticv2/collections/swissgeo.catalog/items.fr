            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bfe.solarenergie-eignung-fassaden:wmts",
        "title": "Potentiel des façades des bâtiments en matière d'exploitation de l'énergie solaire",
        "type": "Dataset"
      }
