            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.armasuisse.natur-landschaft_armee:wmts",
        "title": "Nature Paysage Armée (NPA), valeurs naturelles/ habitats sur des terrains utilisés par l'armée",
        "type": "Dataset"
      }
