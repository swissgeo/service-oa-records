            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": null,
        "title": "swissEO VHI: État de santé de la forêt v200",
        "type": "Dataset"
      }
