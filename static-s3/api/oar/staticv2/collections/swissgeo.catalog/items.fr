          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.gefahren-baugrundklassen:wmts",
        "title": "Cartes des classes de sol de fondation sismiques selon la norme de construction SIA 261",
        "type": "Dataset"
