            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.aquaprotect_050:wmts",
        "title": "Zones inondables Aquaprotect: période de retour de 50 ans",
        "type": "Dataset"
      }
    },
