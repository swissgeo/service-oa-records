            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bfe.ladebedarfswelt-heimladeverfuegbarkeit_geplant:wmts",
        "title": "Disponibilité de la recharge à domicile dans le monde de la recharge « Planifié » pour l'année 2035",
        "type": "Dataset"
      }
    },
