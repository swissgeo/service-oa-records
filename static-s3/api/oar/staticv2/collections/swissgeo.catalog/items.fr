            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": null,
        "title": "Cartes de dispersion des amphibiens",
        "type": "Dataset"
      }
