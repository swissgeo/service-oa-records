            "dir": "ltr",
            "alternate": "French"
          },
          {
            "code": "it",
            "name": "Italiano",
            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.swisstopo.geologie-geomol-temperatur_top_muschelkalk:wms",
        "title": "Modèle de température souterraine du Plateau suisse - températures au Top du Muschelkalk",
        "type": "Dataset"
      }
    },
