            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.erosion-gruenland_bodenabtrag_mrz:wmts",
        "title": "Cartes mensuelles des risques d'érosion des prairies permanentes suisses, perte moyenne de sol en tonnes (ha*mois), mars",
        "type": "Dataset"
      }
