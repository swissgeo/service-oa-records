          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.agroscope.amphibien-ausbreitungskarten_bombia_variegata:wmts",
        "title": "Cartes de dispersion des amphibiens - Bombia variegata",
        "type": "Dataset"
      }
