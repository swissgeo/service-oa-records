            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.swisstopo.fixpunkte-lfp1:wms",
        "title": "Points fixes planimétriques (PFP1) (mensuration nationale)",
        "type": "Dataset"
      }
