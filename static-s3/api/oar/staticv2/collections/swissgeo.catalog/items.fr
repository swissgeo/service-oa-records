            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.swisstopo.geologie-geodaesie-isostatische_anomalien:wmts",
        "title": "Carte gravimétrique de la Suisse (Anomalies isostatiques) 1:500000",
