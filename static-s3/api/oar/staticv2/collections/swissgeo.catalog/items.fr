            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.swisstopo.swissimage-product.metadata:wmts",
        "title": "Découpage en tuile SWISSIMAGE Voyage dans le temps",
        "type": "Dataset"
      }
    },
