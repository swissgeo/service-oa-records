            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.wald-niederschlag_sommer_2085_stark:wmts",
        "title": "Précipitations cumulées juin-août, période 2070-2099, scénario RCP 8.5",
        "type": "Dataset"
      }
    },
