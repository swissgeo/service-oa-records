            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.geochemischer-bodenatlas_schweiz_natrium:wmts",
        "title": "Atlas géochimique des sols de la Suisse: Sodium",
        "type": "Dataset"
      }
    },
