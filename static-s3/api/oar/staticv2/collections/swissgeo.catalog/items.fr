            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.gewaesserschutz-chemischer_zustand_ammonium:wms",
        "title": "L’appréciation de l’état chimique des eaux au regard des concentrations d' ammonium",
        "type": "Dataset"
      }
