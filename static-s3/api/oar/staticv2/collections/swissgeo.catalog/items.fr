            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.gewaesserschutz-biologischer_zustand_makrophyten:wms",
        "title": ". L’appréciation de l’état chimique des eaux au regard des analyses des macrophytes",
        "type": "Dataset"
      }
