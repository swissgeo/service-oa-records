      "id": "ch.agroscope.fokuskarte-voegel",
      "links": [
        {
          "href": "https://services.dev.sgdi.tech/api/oar/staticv2/collections/swissgeo.catalog/items/ch.agroscope.fokuskarte-voegel?language=fr",
