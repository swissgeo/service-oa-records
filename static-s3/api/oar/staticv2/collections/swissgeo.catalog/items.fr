          }
        ],
        "preferredDistributionId": "ch.bfe.solarenergie-einstrahlung_30_grad:wmts",
        "title": "Rayonnement solaire sur une surface inclinée à 30° vers le sud",
        "type": "Dataset"
      }
    },
