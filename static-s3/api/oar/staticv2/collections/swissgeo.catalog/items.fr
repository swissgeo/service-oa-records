            "dir": "ltr",
            "alternate": "French"
          },
          {
            "code": "it",
            "name": "Italiano",
            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.agroscope.amphibien-ausbreitungskarten_epidalea_calamita:wmts",
        "title": "Cartes de dispersion des amphibiens - Epidalea calamita",
        "type": "Dataset"
      }
