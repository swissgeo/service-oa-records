            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.meteoschweiz.hagelgefaehrdung-korngroesse_100_jahre:wms",
        "title": "Danger de grêle sur une surface de référence de 100 m2: taille des grêlons pour une période de retour de 100 ans",
        "type": "Dataset"
      }
