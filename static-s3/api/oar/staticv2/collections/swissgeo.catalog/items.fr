            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bfs.landschaftswandel:wmts",
        "title": "L'évolution du paysage en Suisse",
        "type": "Dataset"
      }
    },
