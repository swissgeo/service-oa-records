      "properties": {
        "contacts": [
          {
            "organization": "Office fédéral de la culture",
            "country": "CH",
            "role": "owner"
          },
          {
            "organization": "Office fédéral de la culture - ISOS",
            "country": "CH",
            "role": "pointOfContact"
