            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.gewaesserschutz-biologischer_zustand_diatomeen:wms",
        "title": "L’appréciation de l’état biologique des eaux au regard des analyses des diatomées",
        "type": "Dataset"
      }
