            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.swisstopo.geologie-geomol-isotherme_60:wms",
        "title": "Modèle de température souterraine du Plateau suisse - altitude de l'isotherme 60 °C",
        "type": "Dataset"
      }
    },
