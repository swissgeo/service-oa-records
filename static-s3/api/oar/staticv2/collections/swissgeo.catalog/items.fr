            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.sturm-staudruck_300:wmts",
        "title": "Tempêtes: pression dynamique avec période de retour de 300 ans",
        "type": "Dataset"
      }
    },
