            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.wrz-wildruhezonen_portal:wmts",
        "title": "Zones de tranquillité",
        "type": "Dataset"
      }
    },
