          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bfe.ladebedarfswelt-heimladeverfuegbarkeit_flexibel:wmts",
        "title": "Disponibilité de la recharge à domicile dans le monde de la recharge « Flexible » pour l'année 2035",
        "type": "Dataset"
      }
