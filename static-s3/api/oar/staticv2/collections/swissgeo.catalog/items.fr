            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.geochemischer-bodenatlas_schweiz_thallium:wmts",
        "title": "Atlas géochimique des sols de la Suisse: thallium",
        "type": "Dataset"
      }
