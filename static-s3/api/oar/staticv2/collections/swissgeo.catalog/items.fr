            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bag.zeckenstichmodell:wmts",
        "title": "Modèle de tique",
        "type": "Dataset"
      }
