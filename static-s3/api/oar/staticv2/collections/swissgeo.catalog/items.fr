            "alternate": "French"
          },
          {
            "code": "it",
            "name": "Italiano",
            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.swisstopo.geologie-geomol-temperaturverteilung_2000:wmts",
        "title": "Modèle de température souterraine du Plateau suisse - distribution de la température à 2000 m de profondeur",
        "type": "Dataset"
      }
    },
