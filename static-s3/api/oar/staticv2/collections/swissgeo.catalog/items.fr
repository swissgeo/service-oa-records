            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.silvaprotect-hangmuren:wmts",
        "title": "SilvaProtect-CH (indications de danger au niveau national) : coulées de boue",
        "type": "Dataset"
      }
    },
