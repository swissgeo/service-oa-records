            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.luftreinhaltung-stickstoffdioxid:wmts",
        "title": "Pollution atmosphérique par les dioxyde d'azote",
        "type": "Dataset"
      }
