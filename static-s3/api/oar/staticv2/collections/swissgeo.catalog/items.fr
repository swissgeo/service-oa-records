          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bazl.laermbelastungskataster-zivilflugplaetze_militaer-gesamt:wms",
        "title": "Cadastres de bruit pour les aérodromes civils - Exposition au bruit de l'aérodrome militaire, trafic civil compris Lr",
        "type": "Dataset"
      }
