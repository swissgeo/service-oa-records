            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.sturm-boeenspitzen_300:wmts",
        "title": "Tempêtes: rafales avec période de retour de 300 ans",
        "type": "Dataset"
      }
