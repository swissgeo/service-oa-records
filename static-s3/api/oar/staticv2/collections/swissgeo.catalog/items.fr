          }
        ],
        "preferredDistributionId": "ch.bafu.neophyten-nuttalls_wasserpest:wmts",
        "title": "Plantes exotiques envahissantes - Carte de distribution potentiel Elodée de Nuttall",
        "type": "Dataset"
      }
