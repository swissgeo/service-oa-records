          }
        ],
        "preferredDistributionId": "ch.bafu.schutzgebiete-aulav_moorlandschaften:wmts",
        "title": "Zones protégées de la publication civile des obstacles à la navigation aérienne - Sites marécageux",
        "type": "Dataset"
      }
