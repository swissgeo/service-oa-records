            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.auen-vegetationskarten:wmts",
        "title": "Cartographie des zones alluviales d'importance nationale",
        "type": "Dataset"
      }
