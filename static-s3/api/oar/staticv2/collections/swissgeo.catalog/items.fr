            "dir": "ltr",
            "alternate": "French"
          },
          {
            "code": "it",
            "name": "Italiano",
            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bfe.windenergie-geschwindigkeit_h150:wms",
        "title": "Atlas des vents de la Suisse: vitesse moyenne et distribution des vents à 150 m du sol",
        "type": "Dataset"
      }
    },
