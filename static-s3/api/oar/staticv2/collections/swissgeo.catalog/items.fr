            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bfe.rohrleitungen-konsultationsbereiche:wmts",
        "title": "Situation et domaines attenants conformément à l'ordonnance sur la protection contre les accidents majeurs (OPAM): domaine des installations de transport par conduites",
        "type": "Dataset"
      }
