            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.swisstopo.geologie-geotope:wmts",
        "title": "Géotopes suisses",
        "type": "Dataset"
      }
