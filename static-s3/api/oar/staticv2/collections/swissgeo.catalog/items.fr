            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bakom.notruf:wmts",
        "title": "Appels d'urgence par commune",
        "type": "Dataset"
      }
    },
