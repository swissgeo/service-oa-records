            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.agroscope.amphibien-ausbreitungskarten_hyla_arborea:wmts",
        "title": "Cartes de dispersion des amphibiens - Hyla arborea",
        "type": "Dataset"
      }
