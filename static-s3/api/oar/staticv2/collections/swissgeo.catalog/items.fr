            "dir": "ltr",
            "alternate": "French"
          },
          {
            "code": "it",
            "name": "Italiano",
            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.niederschlagserosivitaet-okt:wmts",
        "title": "Cartes mensuelles de l'action érosive des précipitations (facteur R) en Suisse en MJ mm ha⁻¹ h⁻¹ mois⁻¹, octobr",
        "type": "Dataset"
      }
    },
