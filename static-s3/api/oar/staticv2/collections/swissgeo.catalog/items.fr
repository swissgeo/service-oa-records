            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bfe.ladebedarfswelt-ladepunkte_flexibel:wmts",
        "title": "Nombre de points de recharge accessibles à tous dans l'univers de recharge « Flexible » pour l'année 2035",
        "type": "Dataset"
      }
