            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bfe.solarenergie-einstrahlung_90_grad:wmts",
        "title": "Rayonnement solaire sur une surface inclinée à 90° vers le sud",
        "type": "Dataset"
      }
    },
