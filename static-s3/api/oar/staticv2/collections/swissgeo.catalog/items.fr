            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.bafu.geochemischer-bodenatlas_schweiz_blei:wmts",
        "title": "Atlas géochimique des sols de la Suisse: Plomb",
        "type": "Dataset"
      }
    },
