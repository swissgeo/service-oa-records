            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.agroscope.abschaetzung-organische_boeden:wms",
        "title": "Répartition des sols organiques en Suisse (Agroscope 2025)",
        "type": "Dataset"
      }
