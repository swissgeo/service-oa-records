            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.nagra.aeromagnetische-karte_1100:wmts",
        "title": "Carte aéromagnétique 1:100000 Argovie jusqu'au Schaffhouse (1100 m)",
        "type": "Dataset"
      }
