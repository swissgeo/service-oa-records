            "dir": "ltr",
            "alternate": "Italian"
          },
          {
            "code": "en",
            "name": "English",
            "dir": "ltr"
          }
        ],
        "preferredDistributionId": "ch.swisstopo.pixelkarte-pk100.metadata:wms",
        "title": "Découpage de la carte nationale 1:100'000 Swiss Map Raster",
        "type": "Dataset"
      }
    },
